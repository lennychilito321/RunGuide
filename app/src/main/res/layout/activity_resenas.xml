<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:paddingTop="44dp"
        android:paddingBottom="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnVolverResenas"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/volver"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#FFFFFF"
            android:textColor="@color/verde_primario"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvTituloResenas"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/resenas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Contador de reseñas -->
    <TextView
        android:id="@+id/tvContadorResenas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resenas_cero"
        android:textSize="14sp"
        android:textColor="@color/texto_secundario"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"/>

    <!-- Lista de reseñas en tarjetas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerResenas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layoutAnimation="@anim/layout_entrada"/>

</LinearLayout>
