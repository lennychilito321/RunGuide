<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="10dp"
    android:background="#FFFFFF"
    android:elevation="3dp">

    <!-- Imagen + badge dificultad -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <ImageView
            android:id="@+id/imgSendero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/montana" />

        <!-- Badge dificultad arriba-derecha -->
        <TextView
            android:id="@+id/tvDificultad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Moderada"
            android:textSize="12sp"
            android:textColor="#5D4037"
            android:background="#FFF9C4" />

    </FrameLayout>

    <!-- Contenido inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNombreSendero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del sendero"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1C1C1C" />

        <TextView
            android:id="@+id/tvUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Tierra"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="⭐ 0.0 (0)"
                android:textSize="13sp"
                android:textColor="#FF9800" />

            <TextView
                android:id="@+id/tvDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.4 km"
                android:textSize="13sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- Botón Ver Ruta -->
        <Button
            android:id="@+id/btnVerRuta"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Ver Ruta"
            android:textSize="14sp"
            android:backgroundTint="#0C8F48"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

        <!-- Botón Eliminar — visible solo admin -->
        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar"
            android:textSize="13sp"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
