<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo de senderos.
     La cabecera (título y opciones) se esconde al deslizar la lista hacia abajo y vuelve
     al deslizar hacia arriba; los filtros quedan fijos. Botón flotante «Iniciar carrera». -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- CABECERA: se esconde al deslizar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:paddingTop="40dp"
            android:paddingBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- Ajustes + título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAjustes"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/ajustes"
                    app:icon="@drawable/ic_ajustes"
                    app:iconSize="22dp"
                    app:iconTint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/runguide"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/encuentra_tu_proxima_ruta"
                        android:textSize="12sp"
                        android:textColor="#BFD3C8" />
                </LinearLayout>
            </LinearLayout>

            <!-- Opciones del usuario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginStart="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavoritos"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/opc_favoritos"
                    app:icon="@drawable/ic_favorito" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDashboard"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/opc_perfil"
                    app:icon="@drawable/ic_perfil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/salir"
                    app:icon="@drawable/ic_salir" />
            </LinearLayout>

            <!-- Herramientas del administrador -->
            <LinearLayout
                android:id="@+id/rowAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevoSendero"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/nuevo_sendero"
                    android:textColor="@color/negro_carbon"
                    app:icon="@drawable/ic_agregar"
                    app:iconTint="@color/negro_carbon"
                    app:backgroundTint="@color/amarillo"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsuarios"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/usuarios_2"
                    app:icon="@drawable/ic_usuarios" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPredeterminados"
                    style="@style/Widget.RunGuide.Opcion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/opc_predeterminados"
                    app:icon="@drawable/ic_estrella" />
            </LinearLayout>
        </LinearLayout>

        <!-- FILTROS: quedan fijos arriba al deslizar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fondo_barra">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="8dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodas"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todos"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFacil"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/facil" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModerada"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/moderado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDificil"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dificil" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvContador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rutas_disponibles_0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- LISTA (y estado vacío): se desliza por debajo de la cabecera -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/estadoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_resultados"
                android:textSize="16sp"
                android:textColor="@color/texto_secundario" />

            <Button
                android:id="@+id/btnLimpiarFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limpiar_filtro"
                android:textAllCaps="false"
                android:backgroundTint="@color/verde_primario"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSenderos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="96dp"
            android:layoutAnimation="@anim/layout_entrada" />
    </FrameLayout>

    <!-- Iniciar una carrera libre (o volver a la que está en curso) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnIniciarCarrera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/iniciar_carrera"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/negro_carbon"
        app:icon="@drawable/ic_correr"
        app:iconTint="@color/negro_carbon"
        app:backgroundTint="@color/amarillo" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
