<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGEN PORTADA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgPortada"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/montana" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_del_sendero_2"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTipoTerreno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tierra"
                    android:textSize="14sp"
                    android:textColor="@color/gris_campo" />

            </LinearLayout>

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/volver"
                android:textSize="12sp"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:backgroundTint="#88000000"
                android:textColor="#FFFFFF" />

        </FrameLayout>

        <!-- ESTADÍSTICAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↗"
                    android:textSize="20sp"
                    android:textColor="@color/verde_primario"/>

                <TextView
                    android:id="@+id/tvDistancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.4"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/km"
                    android:textSize="10sp"
                    android:textColor="@color/texto_secundario"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/moderada"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dificultad"
                    android:textSize="10sp"
                    android:textColor="@color/texto_secundario"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rating"
                    android:textSize="10sp"
                    android:textColor="@color/texto_secundario"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏔"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvElevacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elevacion_ejemplo"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elevacion"
                    android:textSize="10sp"
                    android:textColor="@color/texto_secundario"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/min_est"
                    android:textSize="10sp"
                    android:textColor="@color/texto_secundario"/>

            </LinearLayout>

        </LinearLayout>

        <!-- NIVEL BADGE -->
        <TextView
            android:id="@+id/tvNivelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/nivel_moderada"
            android:textSize="13sp"
            android:textColor="@color/amarillo_texto"
            android:background="@drawable/bg_badge_amarillo" />

        <!-- DESCRIPCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/descripcion"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_descripcion"
                android:textSize="14sp"
                android:textColor="@color/texto_secundario"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- UBICACIÓN EN EL MAPA (siempre visible, debajo de la descripción) -->
        <LinearLayout
            android:id="@+id/cardMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ubicacion_mapa_titulo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="10dp" />

            <!-- Mapa de vista previa: no se mueve; al tocarlo abre el resumen de la ruta -->
            <FrameLayout
                android:id="@+id/contMapa"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/gris_campo">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/mapaToque"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/ver_resumen_ruta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:text="@string/ver_resumen_ruta"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_oscuro"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_badge" />
            </FrameLayout>

            <!-- Se muestra en lugar del mapa cuando el sendero aún no tiene ubicación -->
            <TextView
                android:id="@+id/tvMapaSinUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_ubicacion_sendero"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/filaBotonesMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnAbrirMapa"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="@string/abrir_en_maps"
                    android:textSize="13sp"
                    android:textColor="@color/texto_principal"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnComoLlegar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="@string/como_llegar"
                    android:textSize="13sp"
                    android:backgroundTint="@color/verde_primario"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECCIÓN RESEÑA COMPLETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/califica_y_deja_tu_resena"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="10dp"/>

            <!-- Estrellas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/star1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

            </LinearLayout>

            <!-- Texto de reseña -->
            <EditText
                android:id="@+id/etResena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/escribe_tu_resena_aqui"
                android:minLines="3"
                android:maxLines="5"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <!-- Preview foto reseña -->
            <ImageView
                android:id="@+id/imgFotoResena"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:background="@color/gris_campo"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <!-- Estado foto -->
            <TextView
                android:id="@+id/tvFotoResenaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_foto_opcional"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginBottom="8dp"/>

            <!-- Botón elegir foto -->
            <Button
                android:id="@+id/btnFotoResena"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/agregar_foto_a_la_resena"
                android:textSize="13sp"
                android:backgroundTint="@color/verde_claro"
                android:textColor="@color/verde_primario"
                android:layout_marginBottom="10dp"/>

            <!-- Botón enviar reseña -->
            <Button
                android:id="@+id/btnEnviarResena"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/publicar_resena"
                android:textSize="14sp"
                android:backgroundTint="@color/verde_primario"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- VER RESEÑAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnVerResenas"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/ver_resenas_0"
                android:textSize="14sp"
                android:backgroundTint="@color/superficie"
                android:textColor="@color/texto_principal"/>

        </LinearLayout>

        <!-- BOTONES DE ACCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnIniciarRuta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/iniciar_esta_ruta"
                android:textSize="16sp"
                android:backgroundTint="@color/amarillo"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnFavorito"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/guardar_en_favoritos"
                android:textSize="15sp"
                android:backgroundTint="@color/superficie"
                android:textColor="@color/verde_primario"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
