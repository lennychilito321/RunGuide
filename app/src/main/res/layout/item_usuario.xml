<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borde">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAvatarUsuario"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="U"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/verde_oscuro"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/verde_claro"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usuario"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:id="@+id/tvCorreoUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="correo"
                    android:textSize="12sp"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvRutasUsuario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="0 rutas"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/verde_oscuro" />

            <TextView
                android:id="@+id/tvKmUsuario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0.00 km"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

            <TextView
                android:id="@+id/tvTiempoUsuario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 min"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
