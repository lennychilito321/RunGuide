<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nuevo_sendero"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Campos obligatorios -->
        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nombre_del_sendero"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ubicacion_ej_popayan"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etDificultad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dificultad_toca_para_elegir"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginBottom="8dp"/>

        <!-- Campos opcionales -->
        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etDistancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/distancia_en_km_ej_1_4"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etElevacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/elevacion_ej_80m"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etTipoTerreno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tipo_de_terreno_toca_para_el"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etTiempoEstimado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tiempo_estimado_en_minutos_e"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/descripcion_del_sendero"
            android:minLines="3"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <!-- SECCIÓN FOTO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/foto_del_sendero"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="8dp"/>

        <!-- Preview de la foto elegida -->
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/gris_campo"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvFotoEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sin_foto_seleccionada"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnElegirFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/elegir_foto_de_la_galeria"
            android:backgroundTint="@color/verde_primario"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- Botones principales -->
        <Button
            android:id="@+id/btnCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_sendero"
            android:backgroundTint="@color/verde_primario"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancelar"
            android:backgroundTint="@color/texto_secundario"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>
