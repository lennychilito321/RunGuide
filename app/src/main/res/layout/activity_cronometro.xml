<?xml version="1.0" encoding="utf-8"?>
<!-- Actividad en curso, al estilo Strava: mapa en vivo con el panel de datos abajo,
     o la vista de «datos grandes» (tiempo, ritmo y distancia a pantalla completa). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:keepScreenOn="true">

    <!-- Mapa en vivo -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapaRuta"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Vista de datos grandes (tapa el mapa cuando está activa) -->
    <LinearLayout
        android:id="@+id/vistaDatos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/superficie"
        android:paddingTop="120dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGrandeTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/texto_principal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tiempo_t"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvGrandeRitmo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="—"
            android:textSize="96sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ritmo_label"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvGrandeKm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="0.00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distancia_label"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario" />
    </LinearLayout>

    <!-- Barra superior flotante: estado, nombre y cambio de vista -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/corriendo"
                android:textSize="11sp"
                android:textColor="@color/verde_primario" />

            <TextView
                android:id="@+id/tvNombreSendero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carrera_libre"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVistaDatos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="@string/ver_datos"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Parte inferior: botón de centrar + panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnCentrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="📍"
            android:textSize="20sp"
            android:contentDescription="@string/centrar_mapa"
            android:background="@drawable/bg_circulo"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_inferior"
            android:elevation="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Tiempo · Ritmo · Distancia (el ritmo en grande, como en Strava) -->
            <LinearLayout
                android:id="@+id/filaMetricas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCronometro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tiempo_t"
                        android:textSize="11sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvRitmo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ritmo_label"
                        android:textSize="11sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/distancia_label"
                        android:textSize="11sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
            </LinearLayout>

            <!-- Avance respecto al sendero (solo cuando es la ruta de un sendero) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresoDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                app:trackThickness="8dp"
                app:trackCornerRadius="4dp"
                app:trackColor="@color/gris_campo"
                app:indicatorColor="@color/verde_primario" />

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvTiempoEstimado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:gravity="center" />

            <!-- Pausar / Finalizar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnPausar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="@string/pausar"
                    android:textSize="15sp"
                    android:textColor="@color/texto_principal"
                    app:strokeColor="@color/borde"
                    app:cornerRadius="27dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnFinalizar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="@string/finalizar"
                    android:textSize="15sp"
                    android:backgroundTint="@color/peligro"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="27dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
