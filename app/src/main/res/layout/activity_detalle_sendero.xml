<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGEN PORTADA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgPortada"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/montana" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del sendero"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTipoTerreno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Tierra"
                    android:textSize="14sp"
                    android:textColor="#EEEEEE" />

            </LinearLayout>

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Volver"
                android:textSize="12sp"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:backgroundTint="#88000000"
                android:textColor="#FFFFFF" />

        </FrameLayout>

        <!-- ESTADÍSTICAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↗"
                    android:textSize="20sp"
                    android:textColor="#0C8F48"/>

                <TextView
                    android:id="@+id/tvDistancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.4"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM"
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moderada"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIFICULTAD"
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RATING"
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏔"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvElevacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10m"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ELEVACIÓN"
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIN EST."
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

        </LinearLayout>

        <!-- NIVEL BADGE -->
        <TextView
            android:id="@+id/tvNivelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="📋 Nivel: Moderada"
            android:textSize="13sp"
            android:textColor="#5D4037"
            android:background="#FFF9C4" />

        <!-- DESCRIPCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin descripción."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- SECCIÓN RESEÑA COMPLETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Califica y deja tu reseña"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:layout_marginBottom="10dp"/>

            <!-- Estrellas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/star1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/star5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/darker_gray"
                    android:padding="0dp"/>

            </LinearLayout>

            <!-- Texto de reseña -->
            <EditText
                android:id="@+id/etResena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escribe tu reseña aquí..."
                android:minLines="3"
                android:maxLines="5"
                android:inputType="textMultiLine"
                android:background="#F5F5F5"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <!-- Preview foto reseña -->
            <ImageView
                android:id="@+id/imgFotoResena"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <!-- Estado foto -->
            <TextView
                android:id="@+id/tvFotoResenaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin foto (opcional)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="8dp"/>

            <!-- Botón elegir foto -->
            <Button
                android:id="@+id/btnFotoResena"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="📷 Agregar foto a la reseña"
                android:textSize="13sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1565C0"
                android:layout_marginBottom="10dp"/>

            <!-- Botón enviar reseña -->
            <Button
                android:id="@+id/btnEnviarResena"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="✅ Publicar reseña"
                android:textSize="14sp"
                android:backgroundTint="#0C8F48"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- VER RESEÑAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnVerResenas"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="💬 Ver Reseñas (0)"
                android:textSize="14sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#333333"/>

        </LinearLayout>

        <!-- BOTONES DE ACCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnIniciarRuta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶  Iniciar esta ruta"
                android:textSize="16sp"
                android:backgroundTint="#CDDC39"
                android:textColor="#1C1C1C"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnFavorito"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🤍 Guardar en Favoritos"
                android:textSize="15sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#0C8F48"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
