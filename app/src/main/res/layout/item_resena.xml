<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borde">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: avatar + usuario + estrellas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="U"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/verde_oscuro"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/verde_claro"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUsuarioResena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usuario"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:id="@+id/tvFechaResena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13/05/2026"
                    android:textSize="11sp"
                    android:textColor="@color/texto_secundario" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEstrellas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★"
                android:textSize="16sp"
                android:textColor="@color/estrella" />

            <!-- Menú ⋮ (solo admin) -->
            <TextView
                android:id="@+id/btnMenuResena"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⋮"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Texto de la reseña -->
        <TextView
            android:id="@+id/tvTextoResena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto de la reseña..."
            android:textSize="14sp"
            android:textColor="@color/texto_principal"
            android:lineSpacingExtra="3dp" />

        <!-- Foto de la reseña (si tiene) -->
        <ImageView
            android:id="@+id/imgResena"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
