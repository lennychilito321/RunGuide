<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de toda la app: el paisaje con un velo encima.
     El velo es claro en modo claro y oscuro en modo oscuro (ver velo_fondo en colors). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fondo_app" />
    <item>
        <bitmap
            android:src="@drawable/fondo_paisaje"
            android:gravity="fill" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/velo_fondo" />
        </shape>
    </item>
</layer-list>
