<?xml version="1.0" encoding="utf-8"?>
<!-- Una actividad del historial: nombre, fecha y distancia · tiempo · ritmo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvActIcono"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="🏃"
        android:textSize="20sp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="@color/verde_claro"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActItemNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvActItemFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvActItemDatos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/verde_primario" />
    </LinearLayout>
</LinearLayout>
