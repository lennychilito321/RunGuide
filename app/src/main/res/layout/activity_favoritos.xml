<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:paddingTop="44dp"
        android:paddingBottom="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnVolverFavoritos"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/volver"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#FFFFFF"
            android:textColor="@color/verde_primario"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/mis_favoritos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvContadorFavoritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/favoritos_cero"
        android:textSize="14sp"
        android:textColor="@color/texto_secundario"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp" />

    <!-- ESTADO VACÍO -->
    <LinearLayout
        android:id="@+id/estadoVacioFavoritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textSize="48sp"
            android:textColor="@color/corazon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aun_no_tienes_favoritos"
            android:textSize="16sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnExplorar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/explorar_senderos"
            android:textAllCaps="false"
            android:backgroundTint="@color/verde_primario"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layoutAnimation="@anim/layout_entrada" />

</LinearLayout>
