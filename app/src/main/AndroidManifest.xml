<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET para Firebase y para descargar los mapas de OpenStreetMap -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS: ubicación precisa mientras la app está en primer plano -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Seguir registrando la actividad con la pantalla bloqueada (servicio en primer plano
         con notificación). No hace falta el permiso de ubicación «todo el tiempo». -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RunGuideApp"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:theme="@style/Theme.RunGuide">

        <!-- Registro del GPS en segundo plano durante una actividad -->
        <service
            android:name=".RecorridoService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Comparte la imagen del resumen con otras apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>

        <!-- Resumen al terminar una actividad (tarjeta para compartir) -->
        <activity
            android:name=".ResumenActividadActivity"
            android:exported="false" />

        <!-- Resumen de la ruta: mapa, datos y botón para iniciarla -->
        <activity
            android:name=".RutaResumenActivity"
            android:exported="false" />

        <!-- Elegir la ubicación de un sendero en el mapa (solo admin) -->
        <activity
            android:name=".ElegirUbicacionActivity"
            android:exported="false" />

        <!-- Ajustes: tema e idioma -->
        <activity
            android:name=".AjustesActivity"
            android:exported="false" />

        <activity
            android:name=".AdminActivity"
            android:exported="false" />

        <!-- Usuarios y sus estadísticas (solo admin) -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".SenderosActivity"
            android:exported="false" />

        <!-- Detalle de cada sendero -->
        <activity
            android:name=".DetalleSenderoActivity"
            android:exported="false" />

        <!-- Reseñas de un sendero -->
        <activity
            android:name=".ResenasActivity"
            android:exported="false" />

        <!-- Lista de senderos favoritos del usuario -->
        <activity
            android:name=".FavoritosActivity"
            android:exported="false" />

        <!-- Cronómetro GPS mientras se corre -->
        <activity
            android:name=".CronometroActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Dashboard del usuario -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Inicio de sesión (se abre desde la pantalla de carga) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pantalla de carga: es la que abre el ícono de la app -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RunGuide.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
