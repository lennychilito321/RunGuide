<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET para Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS: ubicación precisa mientras la app está en primer plano -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:icon="@drawable/logo"
        android:label="RunerGuide"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".AdminActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".SenderosActivity"
            android:exported="false" />

        <!-- NUEVA: detalle de cada sendero -->
        <activity
            android:name=".DetalleSenderoActivity"
            android:exported="false" />

        <!-- NUEVA: cronómetro GPS mientras se corre -->
        <activity
            android:name=".CronometroActivity"
            android:exported="false" />

        <!-- NUEVA: dashboard del usuario -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
